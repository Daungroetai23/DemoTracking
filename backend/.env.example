# Copy this file to .env and fill in your values
# cp .env.example .env

NODE_ENV=development
PORT=5000

# TiDB Cloud MySQL connection string (requires SSL)
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE?sslaccept=strict

# JWT signing secret - use a strong random string in production
JWT_SECRET=your-secret-key-here

# Frontend URL (for CORS) - set in production
# FRONTEND_URL=https://your-frontend.vercel.app
