# Copy this file to .env and fill in your values
# cp .env.example .env

NODE_ENV=development
PORT=5000

# TiDB Cloud MySQL connection string (requires SSL)
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE?sslaccept=strict

# JWT signing secret - use a strong random string in production
JWT_SECRET=your-secret-key-here

# Longdo Map API Key (Optional - สมัครฟรีที่ https://map.longdo.com/console ได้ 100,000 ครั้ง/เดือน)
# ถ้าไม่ใส่ระบบจะ Fallback ไปใช้ OpenStreetMap + Google Maps Link อัตโนมัติ
# LONGDO_MAP_KEY=your_longdo_map_key_here
